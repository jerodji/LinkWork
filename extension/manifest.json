{
  "manifest_version": 3,
  "name": "LinkWork 文案提取",
  "version": "0.2.21",
  "description": "在浏览器右侧边栏输入链接，提取视频口播稿、图文文案，一键复制。需要本地 LinkWork 服务。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkWork 文案提取",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
